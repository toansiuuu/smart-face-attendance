# Copy to .env in the project root. Never commit .env or real provider credentials.
# Email recovery: use the SMTP settings supplied by your mail provider.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true

# SMS recovery: Twilio Account SID/Auth Token and an SMS-capable sender number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RECOVERY_PHONE_COUNTRY_CODE=84

# For the seeded manager that has no linked employee profile (optional).
RECOVERY_ADMIN_USERNAME=admin
RECOVERY_ADMIN_EMAIL=
RECOVERY_ADMIN_PHONE=
